# ========================================================
# CAU HINH BIEN MOI TRUONG DU AN TELEGRAM FINANCE BOT (v2.1.1)
# Sao chep file nay thanh ".env" va dien thong tin that cua ban
# ========================================================

# 1. Telegram Bot Token nhan tu @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram Admin Chat ID
ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE

# 3. Danh sach User IDs duoc phep truy cap (cach nhau boi dau phay)
ALLOWED_USER_IDS=YOUR_USER_ID_1, YOUR_USER_ID_2
ADMIN_IDS=YOUR_USER_ID_1, YOUR_USER_ID_2

# 4. Google Sheets Database ID (De trong de GAS tu dong tao file moi gan voi du an)
SHEET_ID=

# 5. Google Apps Script ID
GAS_SCRIPT_ID=YOUR_GOOGLE_APPS_SCRIPT_ID_HERE

# 6. Webhook URL cua Google Apps Script sau khi Deploy Web App
WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
