# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN TELEGRAM FINANCE BOT (LOCAL DEV)
# ========================================================

# 1. Telegram Bot Token nhận từ @BotFather (@SuperFinanceGAS_bot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram Admin Chat ID (để nhận thông báo / phân quyền Admin)
ADMIN_CHAT_ID=

# 3. Danh sách User ID được phép dùng Bot (ngăn cách bằng dấu phẩy)
ALLOWED_USER_IDS=
ADMIN_IDS=

# 3b. Danh sách ID Nhóm (Group Chat ID, có dấu trừ ở đầu, VD: -1001234567890) được phép dùng Bot
# Hoặc gõ /id hay /setgroup trực tiếp trong nhóm để cấp quyền 1 chạm
ALLOWED_GROUP_IDS=

# 4. Google Sheets Database ID (Trang lưu trữ Giao dịch Tài chính và Logs)
SHEET_ID=

# 5. Google Apps Script ID (lấy từ URL: https://script.google.com/d/<SCRIPT_ID>/edit)
GAS_SCRIPT_ID=

# 6. Webhook URL của Google Apps Script sau khi Deploy Web App
WEBAPP_URL=https://script.google.com/macros/s/XXXXX/exec

# 7. Cấu hình cổng local server nếu muốn test webhook qua ngrok
PORT=3000
