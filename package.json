{
  "name": "telegram-gas-finance-bot",
  "version": "2.2.0",
  "description": "2.2.0 (Hybrid UI): Multi-Fund Finance Bot on Google Apps Script - Open UI Mode 3 Tabs, In-Chat Wizard, Full Calculator (+ - * /) & Continuous Ledger Archive",
  "main": "src/main.js",
  "scripts": {
    "dev": "node local/dev-polling.js",
    "test:sim": "node local/simulate.js",
    "stop": "node local/emergency-stop.js",
    "webhook:info": "node local/manage-webhook.js info",
    "webhook:set": "node local/manage-webhook.js set",
    "webhook:delete": "node local/manage-webhook.js delete",
    "clasp:login": "clasp login",
    "clasp:status": "clasp status",
    "clasp:create": "clasp create --type webapp --title \"SuperFinanceGAS_Bot\" --rootDir ./src",
    "push": "clasp push",
    "push:watch": "clasp push --watch",
    "pull": "clasp pull",
    "open": "clasp open",
    "deploy": "clasp deploy -i YOUR_DEPLOYMENT_ID --description \"Production Release v2.2.0 Hybrid UI\"",
    "logs": "clasp logs"
  },
  "keywords": [
    "telegram-bot",
    "google-apps-script",
    "clasp",
    "finance-bot",
    "hybrid-ui",
    "webapp",
    "solid"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "dotenv": "^18.0.5"
  }
}
